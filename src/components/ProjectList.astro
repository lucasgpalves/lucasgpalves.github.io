---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/config';
import { projectPath } from '../i18n/config';
import { projectSummary, projectTitle } from '../i18n/content';
import { useTranslations } from '../i18n/utils';

interface Props {
  projects: CollectionEntry<'projetos'>[];
  showContext?: boolean;
  lang?: Lang;
}

const { projects, showContext = false, lang = 'pt' } = Astro.props;
const t = useTranslations(lang);

const statusLabel = {
  done: t('statusDone'),
  'in-progress': t('statusProgress'),
  historical: t('statusHistorical'),
};

const contextLabel = {
  professional: t('contextChipPro'),
  lab: t('contextChipLab'),
};
---

<div class="project-list">
  {
    projects.map((project) => (
      <a class="project-item" href={projectPath(lang, project.id)}>
        <div>
          <h3>{projectTitle(project, lang)}</h3>
          <p>{projectSummary(project, lang)}</p>
          <div class="meta">
            {showContext && (
              <span class="chip chip-context">{contextLabel[project.data.context]}</span>
            )}
            {project.data.labels.map((label) => (
              <span class="chip">{label}</span>
            ))}
          </div>
        </div>
        <span class="status">{statusLabel[project.data.status]}</span>
      </a>
    ))
  }
</div>
