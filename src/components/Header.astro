---
import { getBio } from '../data/bio';
import type { Lang } from '../i18n/config';
import { localizePath } from '../i18n/utils';
import { switchLanguagePath, useTranslations } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const lang: Lang = Astro.props.lang ?? 'pt';
const bio = getBio(lang);
const t = useTranslations(lang);
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';
const otherHref = switchLanguagePath(pathname, otherLang);

const links = [
  { href: localizePath(lang, 'projects'), label: t('navProjects') },
  { href: localizePath(lang, 'writing'), label: t('navWriting') },
  { href: localizePath(lang, 'about'), label: t('navAbout') },
];
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href={localizePath(lang, 'home')}>
      {bio.name.split(' ')[0]} <span>Alves</span>
    </a>
    <div class="nav-right">
      <nav aria-label={t('navAria')}>
        <ul class="nav-links">
          {
            links.map((link) => {
              const current =
                pathname === link.href || pathname.startsWith(`${link.href}/`);
              return (
                <li>
                  <a href={link.href} aria-current={current ? 'page' : undefined}>
                    {link.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
      <a
        class="lang-toggle"
        href={otherHref}
        aria-label={t('langSwitchAria')}
        title={t('langSwitchAria')}
        hreflang={otherLang === 'en' ? 'en' : 'pt-BR'}
      >
        {t('langSwitch')}
      </a>
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        aria-label={t('themeToggle')}
        title={t('themeToggle')}
      >
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script define:vars={{ toLight: t('themeToLight'), toDark: t('themeToDark') }}>
  function currentTheme() {
    return document.documentElement.getAttribute('data-theme') === 'dark'
      ? 'dark'
      : 'light';
  }

  function applyTheme(theme) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
    const toggle = document.querySelector('[data-theme-toggle]');
    if (toggle) {
      toggle.setAttribute('aria-label', theme === 'dark' ? toLight : toDark);
    }
  }

  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      applyTheme(currentTheme() === 'dark' ? 'light' : 'dark');
    });
  });
</script>
