---
import { getBio } from '../data/bio';
import type { Lang } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const lang: Lang = Astro.props.lang ?? 'pt';
const bio = getBio(lang);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-row">
    <p>© {year} {bio.name} — {bio.label}</p>
    <div class="footer-links">
      {
        bio.profiles.map((profile) => (
          <a href={profile.url} rel="noopener noreferrer" target="_blank">
            {profile.network}
          </a>
        ))
      }
      <a href={`mailto:${bio.email}`}>{t('email')}</a>
    </div>
  </div>
</footer>
