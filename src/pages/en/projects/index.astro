---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectList from '../../../components/ProjectList.astro';
import { getBio } from '../../../data/bio';
import { useTranslations } from '../../../i18n/utils';

const lang = 'en' as const;
const bio = getBio(lang);
const t = useTranslations(lang);

const all = (await getCollection('projetos')).filter(
  (p) => p.data.category === 'devops',
);

const professional = all
  .filter((p) => p.data.context === 'professional')
  .sort((a, b) => a.data.order - b.data.order);

const lab = all
  .filter((p) => p.data.context === 'lab')
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  lang={lang}
  title={`${t('navProjects')} | ${bio.name}`}
  description={t('featuredLead')}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">{t('projectsEyebrow')}</p>
      <h1>{t('projectsTitle')}</h1>
      <p>{t('projectsLead')}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t('workEyebrow')}</p>
          <h2>{t('workTitle')}</h2>
          <p>{t('workLead')}</p>
        </div>
      </div>
      <ProjectList projects={professional} lang={lang} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t('labEyebrow')}</p>
          <h2>{t('labTitle')}</h2>
          <p>{t('labLead')}</p>
        </div>
      </div>
      <ProjectList projects={lab} lang={lang} />
    </div>
  </section>
</BaseLayout>
