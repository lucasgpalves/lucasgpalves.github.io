---
import CvLayout from '../layouts/CvLayout.astro';
import ResumeDocument from '../components/ResumeDocument.astro';
import { cvPdfPath } from '../i18n/config';

const lang = 'pt' as const;
---

<CvLayout lang={lang}>
  <div class="cv-shell">
    <div class="cv-toolbar">
      <a href="/">← Site</a>
      <a class="primary" href={cvPdfPath(lang)} download>
        Baixar PDF
      </a>
    </div>
    <ResumeDocument lang={lang} />
  </div>
</CvLayout>
