---
import BaseLayout from '../layouts/BaseLayout.astro';
import StackWall from '../components/StackWall.astro';
import { getBio } from '../data/bio';
import { cvPdfPath } from '../i18n/config';
import { localizePath, useTranslations } from '../i18n/utils';

const lang = 'pt' as const;
const bio = getBio(lang);
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={`${t('navAbout')} | ${bio.name}`} description={bio.summary}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">{t('aboutEyebrow')}</p>
      <h1>{bio.name}</h1>
      <p>{bio.summary}</p>
      <p style="margin-top: 0.75rem; color: var(--ink-muted);">
        {bio.location}
      </p>
      <div class="cta-row">
        {
          bio.profiles.map((profile) => (
            <a
              class="btn btn-ghost"
              href={profile.url}
              rel="noopener noreferrer"
              target="_blank"
            >
              {profile.network}
            </a>
          ))
        }
        <a class="btn btn-ghost" href={cvPdfPath(lang)} download>{t('ctaCv')}</a>
        <a class="btn btn-ghost" href={localizePath(lang, 'cv')}>{t('ctaCvView')}</a>
        <a class="btn btn-primary" href={`mailto:${bio.email}`}>{t('email')}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t('experienceEyebrow')}</p>
          <h2>{t('experienceTitle')}</h2>
        </div>
      </div>
      <div class="timeline">
        {
          bio.work.map((job) => (
            <div class="timeline-item">
              <h3>
                {job.position}
                {'company' in job && job.company ? ` — ${job.company}` : ''}
              </h3>
              <p class="when">
                {job.startDate} — {job.endDate}
                {'status' in job && job.status ? ` · ${job.status}` : ''}
              </p>
              <p style="margin: 0; color: var(--ink-muted);">{job.summary}</p>
              <ul class="prose">
                {job.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <StackWall lang={lang} />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t('certsEyebrow')}</p>
          <h2>{t('certsTitle')}</h2>
        </div>
      </div>
      <ul class="language-list">
        {
          bio.certifications.map((item) => (
            <li>
              {item.url ? (
                <a class="language-name" href={item.url} target="_blank" rel="noopener noreferrer">
                  {item.name}
                </a>
              ) : (
                <span class="language-name">{item.name}</span>
              )}
              <span class="language-level">
                {item.issuer} · {item.date}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t('languagesEyebrow')}</p>
          <h2>{t('languagesTitle')}</h2>
        </div>
      </div>
      <ul class="language-list">
        {
          bio.languages.map((item) => (
            <li>
              <span class="language-name">{item.language}</span>
              <span class="language-level">{item.fluency}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t('educationEyebrow')}</p>
          <h2>{t('educationTitle')}</h2>
        </div>
      </div>
      <div class="timeline">
        {
          bio.education.map((edu) => (
            <div class="timeline-item">
              <h3>
                {edu.studyType}, {edu.area}
              </h3>
              <p class="when">
                {edu.institution} · {edu.startDate} — {edu.endDate}
              </p>
            </div>
          ))
        }
        {
          bio.volunteer.map((item) => (
            <div class="timeline-item">
              <h3>
                {item.position} — {item.organization}
              </h3>
              <p class="when">
                {item.startDate} — {item.endDate}
              </p>
              <p style="margin: 0; color: var(--ink-muted);">{item.summary}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
